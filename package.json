{
  "name": "dsh-dshomepage-skin",
  "version": "0.1.8",
  "description": "DeepSeek Harness homepage-style background skin for the DSH 0.2.x desktop app and dsh web: WebGL fluid, dot grid and digital whale, dark and light variants.",
  "license": "MIT",
  "author": "yushi-xxh",
  "icon": "./icon.svg",
  "contributors": [
    "SiriusWJ"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiriusWJ/dsh-dshomepage-skin.git"
  },
  "homepage": "https://github.com/SiriusWJ/dsh-dshomepage-skin#readme",
  "bugs": {
    "url": "https://github.com/SiriusWJ/dsh-dshomepage-skin/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "skin",
    "desktop",
    "homepage"
  ],
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/smoke.cjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
